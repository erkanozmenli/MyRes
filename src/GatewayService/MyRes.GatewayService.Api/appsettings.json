{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApiDocuments": [
    {
      "Name": "gateway",
      "Title": "Gateway API (Overview)",
      "Route": "/openapi/v1.json",
      "UrlOverride": false,
      "IsDefault": true
    },
    {
      "Name": "trips",
      "Title": "Trip API",
      "UrlOverride": true,
      "Route": "/openapi/trips/v1.json"
    }
  ],
  "ReverseProxy": {
    "Routes": {
      "trips-openapi": {
        "ClusterId": "trip-service",
        "Match": {
          "Path": "/openapi/trips/{document}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{document}"
          }
        ]
      },
      "trips-v1": {
        "ClusterId": "trip-service",
        "Match": {
          "Path": "/v1/trips/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathPattern": "/v1/trips/{**catch-all}"
          }
        ]
      },
      "trip-health": {
        "ClusterId": "trip-service",
        "Match": {
          "Path": "/health/trip-service/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "/health/{**catch-all}"
          }
        ]
      },
      "trip-debug": {
        "ClusterId": "trip-service",
        "Match": {
          "Path": "/debug/trip-service/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathPattern": "/debug/{**catch-all}"
          }
        ]
      },
      "payments-v1": {
        "ClusterId": "payment-service",
        "Match": {
          "Path": "/v1/payments/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathPattern": "/v1/payments/{**catch-all}"
          }
        ]
      },
      "payment-health": {
        "ClusterId": "payment-service",
        "Match": {
          "Path": "/health/payment-service/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "/health/{**catch-all}"
          }
        ]
      },
      "providers-v1": {
        "ClusterId": "provider-service",
        "Match": {
          "Path": "/v1/providers/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [
          {
            "PathPattern": "/v1/providers/{**catch-all}"
          }
        ]
      },
      "provider-health": {
        "ClusterId": "provider-service",
        "Match": {
          "Path": "/health/provider-service/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "/health/{**catch-all}"
          }
        ]
      },
      "notifications-v1": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/v1/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/v1/notifications/{**catch-all}"
          }
        ]
      },
      "notification-health": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/health/notification-service/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "/health/{**catch-all}"
          }
        ]
      }
    }
  }
}
