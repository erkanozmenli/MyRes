    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyRes.TripService.Application\MyRes.TripService.Application.csproj" />
    <ProjectReference Include="..\MyRes.TripService.Infrastructure\MyRes.TripService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
